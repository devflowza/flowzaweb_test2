{
  "name": "flowzaweb",
  "version": "0.1.0",
  "private": true,
  "description": "Flowza.ai — flagship marketing website. Next.js App Router, Tailwind v4, fully static-first.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:photos": "node scripts/optimize-photos.mjs",
    "generate:page-images": "node scripts/generate-page-images.mjs",
    "pages:preview": "next build && wrangler pages dev out",
    "pages:deploy": "next build && wrangler pages deploy out --project-name flowzaweb"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "^16.2.12",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.58.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-slug": "^6.0.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.6.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.114.0"
  }
}
