# Supabase (public anon key — security is enforced by RLS; the contact form
# gracefully degrades to a WhatsApp fallback when these are absent).
# NEXT_PUBLIC_ because the static export submits from the browser; the values
# are inlined at build time, so set them wherever the build runs (locally and
# in the Cloudflare Pages project's build environment).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute site origin used for metadata/canonicals in production builds
NEXT_PUBLIC_SITE_URL=https://flowza.ai
